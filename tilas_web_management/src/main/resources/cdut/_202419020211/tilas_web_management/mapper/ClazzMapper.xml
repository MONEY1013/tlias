<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cdut._202419020211.tilas_web_management.mapper.ClazzMapper">

    <select id="pageList" resultType="cdut._202419020211.tilas_web_management.pojo.Clazz">
        select * from clazz
        <where>
            <if test="name != null">
                name like concat('%', #{name}, '%')
            </if>
            <if test="begin != null">
                and create_time >= #{begin}
            </if>
            <if test="end != null">
                and create_time &lt;= #{end}
            </if>

        </where>
        limit #{offset}, #{size}
    </select>
    <select id="count" resultType="java.lang.Long">
        select count(*) from clazz
        <where>
            <if test="name != null">
                name like concat('%', #{name}, '%')
            </if>
            <if test="begin != null">
                and create_time >= #{begin}
            </if>
            <if test="end != null">
                and create_time &lt;= #{end}
            </if>
        </where>
    </select>
</mapper>