<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cdut._202419020211.tilas_web_management.mapper.StuMapper">

    <select id="count" resultType="java.lang.Long">
        select count(*) from student
        <where>
            <if test="name != null and name != ''">
                name like concat('%', #{name}, '%')
            </if>
            <if test="clazzId != null">
                clazz_id = #{clazzId}
            </if>
            <if test="degree != null">
                degree = #{degree}
            </if>
        </where>

    </select>
    <select id="pageList" resultType="cdut._202419020211.tilas_web_management.pojo.Student">
        select * from student
        <where>
            <if test="name != null and name != ''">
                name like concat('%', #{name}, '%')
            </if>
            <if test="clazzId != null">
                clazz_id = #{clazzId}
            </if>
            <if test="degree != null">
                degree = #{degree}
            </if>
        </where>
        limit #{offset}, #{size}
    </select>
</mapper>